          {
            "id": "q2",
            "text": "The selector error proves that the website deletion journey is broken for visitors."
          }
        ],
        "metricRequests": [
          {
            "id": "m1",
            "text": "Number of actions explicitly recorded as completed",
            "unit": "actions",
            "basis": "observed"
          }
