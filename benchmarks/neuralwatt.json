{
  "jobs_dir": ".audit-work/jobs",
  "n_concurrent_trials": 2,
  "n_attempts": 1,
  "agents": [
    {
      "name": "codex",
      "model_name": "neuralwatt/deepseek-v4.1-flash",
      "env": {
        "OPENAI_API_KEY": "${NEURALWATT_API_KEY}"
      },
      "kwargs": {
        "version": "0.166.0",
        "reasoning_effort": "high",
        "reasoning_summary": "none",
        "web_search": "disabled",
        "config": {
          "model_provider": "neuralwatt",
          "model_providers": {
            "neuralwatt": {
              "name": "Neuralwatt",
              "base_url": "https://api.neuralwatt.com/v1",
              "env_key": "OPENAI_API_KEY",
              "wire_api": "responses",
              "supports_websockets": false
            }
          }
        }
      }
    }
  ]
}
