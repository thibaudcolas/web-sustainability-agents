      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "nextStep": {
            "type": "string"
          }
        },
        "required": ["checkId", "title", "summary", "nextStep"],
        "additionalProperties": false
      }
