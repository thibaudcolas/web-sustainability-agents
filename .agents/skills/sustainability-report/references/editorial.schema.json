{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "site": {
      "type": "string"
    },
    "reviewSHA256": {
      "type": "string"
    },
    "writer": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        }
      },
      "required": ["model", "reasoning", "harness"],
      "additionalProperties": false
    },
    "overview": {
      "type": "string"
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "whyItMatters": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        },
        "required": ["checkId", "title", "summary", "whyItMatters", "action"],
