  "assumptions": [
    "Public anonymous access",
    "Desktop first-load headline; narrow viewport and preferences are supplementary",
    "No server measurement",
    "No form submission or account change unless explicitly scoped",
    "English-language sample, public anonymous access, no authenticated or mutating flows",
    "Cold first-load is the headline; post-consent, scrolling, repeat visit and supplementary probes remain separately labeled",
    "Local source has no deployment attestation and may differ from live HTML",
    "Exploratory setup observations select scope and do not establish audit measurements"
  ],
  "optionalEnergy": "none",
  "ownerPriorities": [
    "Complete a fresh full audit through the new skill workflow",
    "Broad checks across a varied page sample",
    "Use owner-supplied local source only as corroboration, with deployment uncertainty explicit"
  ],
  "sampling": {
    "discovery": "Current public homepage navigation, current canonical URLs and rendered search controls; all selected URLs returned 200 during setup",
    "selectedPageCount": 7,
    "omissions": [
      "Authenticated CMS administration, account operations, message submission and newsletter sign-up",
      "Full crawl, all locale variants, all historic releases and blog posts",
      "Server operations, traffic analytics, lifecycle inventory, direct hardware energy measurement"
    ],
    "cookieControls": "Both actual Opt out and Opt in selectors verified visible on wagtail.org; independent fresh contexts per branch",
    "verifiedJourney": "Search overlay opened, query submitted, one matching result selector found, and destination URL with unique h1 verified during setup"
  },
  "execution": {
    "harness": "Codex native subagent",
    "role": "setup and sequential collection",
    "model": "gpt-6.1-sol",
    "reasoning": "high",
    "mode": "native-subagents",
