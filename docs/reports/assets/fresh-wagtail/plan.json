  "journeys": [
    {
      "id": "find-sustainability-policy",
      "url": "https://wagtail.org/",
      "task": "Opt out of optional cookies, search for sustainability, and read the policy",
      "actions": [
        {
          "type": "click",
          "selector": "#opt-out-wagtail-cookie"
        },
        {
          "type": "click",
          "selector": ".header__button--search.u-desktop-only"
        },
        {
          "type": "fill",
          "selector": "#search-input-desktop",
          "value": "sustainability"
        },
        {
          "type": "press",
          "selector": "#search-input-desktop",
          "key": "Enter"
        },
        {
          "type": "click",
          "selector": "main a[href=\"/sustainability/\"]"
        }
      ],
      "success": {
        "url": "https://wagtail.org/sustainability/",
        "selector": "h1",
        "text": "Sustainability"
      }
    }
